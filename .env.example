# --- Payload CMS ---
# Postgres connection string (Neon: Dashboard > Connection string, "pooled")
DATABASE_URL=
# Long random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=
# Vercel Blob (Vercel > Storage > Blob). Empty locally = uploads stored on disk.
BLOB_READ_WRITE_TOKEN=

# --- Contact form (Resend). Without these, messages are only logged in dev. ---
RESEND_API_KEY=
CONTACT_TO=
# Optional, must be a verified Resend domain
CONTACT_FROM=
